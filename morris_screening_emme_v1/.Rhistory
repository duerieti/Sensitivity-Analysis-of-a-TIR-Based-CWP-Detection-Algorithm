library(tidyverse)
morris_design <- readRDS("sa_object.rds")
morris_design$X %>% colnames()
colnames(morrisDesign$X)[colnames(morrisDesign$X) == "slab_halfwidth_m"] <- "step_length"
morrisDesign$factors[morrisDesign$factors == "slab_halfwidth_m"] <- "step_length"
colnames(morris_design$X)[colnames(morris_design$X) == "slab_halfwidth_m"] <- "step_length"
morris_design$factors[morris_design$factors == "slab_halfwidth_m"] <- "step_length"
morris_design$X %>% colnames()
saveRDS(morrisDesign, "sa_object.rds")
saveRDS(morris_design, "sa_object.rds")
q()
