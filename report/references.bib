@article{campolongo_effective_2007,
	title = {An effective screening design for sensitivity analysis of large models},
	volume = {22},
	copyright = {https://www.elsevier.com/tdm/userlicense/1.0/},
	issn = {13648152},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S1364815206002805},
	doi = {10.1016/j.envsoft.2006.10.004},
	abstract = {In 1991 Morris proposed an effective screening sensitivity measure to identify the few important factors in models with many factors. The method is based on computing for each input a number of incremental ratios, namely elementary effects, which are then averaged to assess the overall importance of the input. Despite its value, the method is still rarely used and instead local analyses varying one factor at a time around a baseline point are usually employed.},
	language = {en},
	number = {10},
	urldate = {2026-06-13},
	journal = {Environmental Modelling \& Software},
	author = {Campolongo, Francesca and Cariboni, Jessica and Saltelli, Andrea},
	month = oct,
	year = {2007},
	pages = {1509--1518}
}

