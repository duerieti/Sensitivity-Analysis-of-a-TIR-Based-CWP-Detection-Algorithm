\addvspace {10\p@ }
\contentsline {figure}{\numberline {2-1}{\ignorespaces An example grid $\Omega $. The grid features two parameters $X_1$, $X_2$, meaning that it is a two-dimensional grid. Further, it features four levels ($p = 4$). The step $\Delta $ chosen here is $\frac {2}{3}$ and indicated by the arrows.}}{10}{figure.caption.5}%
\contentsline {figure}{\numberline {2-2}{\ignorespaces An example Morris trajectory through a three-dimensional sampling grid ($k = 3$, $p = 6$). The trajectory consists of $k+1 = 4$ points.}}{11}{figure.caption.6}%
\contentsline {figure}{\numberline {2-3}{\ignorespaces Four example distributions $\mathcal {F}_i$ of a parameter $X_i$, illustrating how $\mu $ and $\sigma $ jointly characterize parameter influence.}}{12}{figure.caption.7}%
\contentsline {figure}{\numberline {2-4}{\ignorespaces The difference of $\mu $ and $\mu ^{\star }$ visualized with their underlying distribution $\mathcal {F}_i$ and $\mathcal {G}_i$. While the $\mu $ lies at around zero, $\mu ^{\star }$ significantly deviates from zero.}}{13}{figure.caption.8}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {1-1}{\ignorespaces Overview of the study area along the Emme river. The map shows the settlements bounding each of the three TIR orthophoto segments (Emme Upper Reach 1, Emme Upper Reach 2, Emme Lower Reach), as well as the three tributary rivers imaged during the survey (Ilfis, Grüene, and Urtene), shown here as a single combined category. Background Image: Swissimage © Swisstopo}}{16}{figure.caption.9}%
\contentsline {figure}{\numberline {3-2}{\ignorespaces Visual overview of the steps involved in determining and classifying step-length-sensitive CWP. The result is a total of 24 classified CWP, where 10 are tributary-caused and 14 are non-tributary-caused.}}{20}{figure.caption.13}%
\contentsline {figure}{\numberline {3-3}{\ignorespaces Visual depiction of the Morris sampling grid, spanning step length and buffer pixel count. The arrow shows the jump distance chosen for the Morris experiment, corresponding to 3 grid levels.}}{21}{figure.caption.14}%
\contentsline {figure}{\numberline {3-4}{\ignorespaces An example setup showing the worker pool. Red: the GNU Parallel process. Orange: 3 worker processes in the pool. Green: actions performed by the worker processes. Blue: files and folders.}}{22}{figure.caption.16}%
\contentsline {figure}{\numberline {3-5}{\ignorespaces Construction of the detection frequency raster. The upper two layers show individual CWP detection outputs from two runs using different parameter tuples. The lower raster shows the resulting detection frequency raster, with gray pixels indicating lower detection frequency than black pixels.}}{23}{figure.caption.17}%
\contentsline {figure}{\numberline {3-6}{\ignorespaces Examples of the four classification outcomes: variable vs. non-variable patches (rows), further split by tributary attribution (columns).}}{24}{figure.caption.18}%
\contentsline {figure}{\numberline {3-7}{\ignorespaces Visual overview of the steps involved in computing Morris sensitivity indices with respect to CWP area. The selected and classified CWP flow into the process at step 4.}}{25}{figure.caption.19}%
\contentsline {figure}{\numberline {3-8}{\ignorespaces Visual depiction of the second Morris sampling grid, spanning step length, buffer pixel count, and the temperature delta threshold. The red arrow indicates the jump distance chosen.}}{26}{figure.caption.20}%
\contentsline {figure}{\numberline {3-9}{\ignorespaces Visual representation of the bounding box computation. One of the 24 selected CWPs is selected using the corresponding bounding box, then aggregation is performed. The resulting statistics can be captured in a table based format together with aggregation results from other selected CWP.}}{27}{figure.caption.21}%
\contentsline {figure}{\numberline {4-10}{\ignorespaces Illustration of the inverse distance weighting scheme used in v3. Each cell's reference temperature is computed as a weighted average of surrounding sample points, where weights decrease with distance.}}{29}{figure.caption.22}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {1-1}{\ignorespaces Execution time of v1 and v2 as a function of step length. In red the original CWP detection algorithm (v1) in blue the speed optimized algorithm (v2).}}{33}{figure.caption.25}%
\contentsline {figure}{\numberline {1-2}{\ignorespaces Comparison of CWP polygon outputs between v1 (blue) and v2 (red) across the three validation runs. Polygons are overlaid at 50\% transparency; areas of agreement appear as a blend of both colours, while areas covered by only one algorithm appear in that algorithm's colour alone.}}{34}{figure.caption.26}%
\contentsline {figure}{\numberline {2-3}{\ignorespaces Morris sensitivity indices ($\mu ^*$ and $\sigma $) for step length with respect to cold water patch area, stratified by patch class.}}{35}{figure.caption.27}%
\contentsline {figure}{\numberline {2-4}{\ignorespaces $\mu ^*$ and $\sigma $ sensitivity indices for buffer pixel count, step length, and temperature delta across all classified cold water patches ($N = 24$ locations, $r = 64$ trajectories).}}{36}{figure.caption.28}%
\contentsline {figure}{\numberline {2-5}{\ignorespaces $\mu ^*$ (step length) versus mean CWP area for each of the 24 annotated locations. Color indicates the mean temperature delta to the surrounding river ($\overline {\Delta T}$, averaged across all Morris runs); shape indicates CWP class (circle: non-tributary-caused; triangle: tributary-caused).}}{37}{figure.caption.29}%
\contentsline {figure}{\numberline {3-6}{\ignorespaces Qualitative comparison of CWP detections between v1 (blue) and v3 (green) at three example locations. v1 polygons and v3 polygons are overlaid at 50\% transparency; areas covered by both algorithms appear as a blend of the two colours, while areas covered by only one algorithm appear in that algorithm's colour alone.}}{38}{figure.caption.31}%
