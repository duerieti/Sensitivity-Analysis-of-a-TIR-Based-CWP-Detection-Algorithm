\contentsline {figure}{\numberline {0-1}{\ignorespaces Annotated locations of cold water patches (CWP) in the Emme River. Each marker indicates the geographic position of a classified CWP. Background Image: Swissimage © Swisstopo }}{49}{figure.caption.33}%
\contentsline {figure}{\numberline {0-2}{\ignorespaces Catalogue of non-tributary-caused cold-water patches ($N = 14$). Each patch is shown as a detection frequency raster excerpt.}}{50}{figure.caption.34}%
\contentsline {figure}{\numberline {0-3}{\ignorespaces Catalogue of tributary-caused cold-water patches ($N = 10$). Each patch is shown as a detection frequency raster excerpt.}}{51}{figure.caption.35}%
