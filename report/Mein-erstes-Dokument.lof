\addvspace {10\p@ }
\contentsline {figure}{\numberline {2.1}{\ignorespaces An example grid $\Omega $. The grid features two parameters $X_1$, $X_2$, meaning that it is a two-dimensional grid. Further, it features four levels ($p = 4$). The step $\Delta $ chosen here is $\frac {2}{3}$ and indicated by the arrows. Figure source: \citep {saltelli_global_2007}}}{4}{figure.caption.5}%
\contentsline {figure}{\numberline {2.2}{\ignorespaces An example Morris trajectory through a three-dimensional sampling grid ($k = 3$, $p = 6$). The trajectory consists of $k+1 = 4$ points. Figure source: \citep {saltelli_global_2007}}}{5}{figure.caption.6}%
\contentsline {figure}{\numberline {2.3}{\ignorespaces Four example distributions $\mathcal {F}_i$ of a parameter $X_i$, illustrating how $\mu $ and $\sigma $ jointly characterize parameter influence.}}{6}{figure.caption.7}%
\contentsline {figure}{\numberline {2.4}{\ignorespaces The difference of $\mu $ and $\mu ^{\star }$ visualized with their underlying distribution $\mathcal {F}_i$ and $\mathcal {G}_i$. While the $\mu $ lies at around zero, $\mu ^{\star }$ significantly deviates from zero.}}{7}{figure.caption.8}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {3.1}{\ignorespaces Overview of the study area along the Emme river. The map shows the settlements bounding each of the three TIR orthophoto segments (Emme Upper Reach 1, Emme Upper Reach 2, Emme Lower Reach), as well as the three tributary rivers imaged during the survey (Ilfis, Grüene, and Urtene), shown here as a single combined category. Background Image: Swissimage © Swisstopo}}{10}{figure.caption.9}%
\contentsline {figure}{\numberline {3.2}{\ignorespaces Visual overview of the steps involved in determining and classifying step-length-sensitive CWP. The result is a total of 24 classified CWP, where 10 are tributary-caused and 14 are non-tributary-caused.}}{14}{figure.caption.13}%
\contentsline {figure}{\numberline {3.3}{\ignorespaces Visual depiction of the Morris sampling grid, spanning step length and reference strip width. The arrow shows the jump distance chosen for the parameter sampling, corresponding to 3 grid levels.}}{15}{figure.caption.14}%
\contentsline {figure}{\numberline {3.4}{\ignorespaces An example setup showing the worker pool. Red: the GNU Parallel process. Orange: 3 worker processes in the pool. Green: actions performed by the worker processes. Blue: files and folders.}}{16}{figure.caption.16}%
\contentsline {figure}{\numberline {3.5}{\ignorespaces Construction of the detection frequency raster. The upper two layers show individual CWP detection outputs from two runs using different parameter tuples. The lower raster shows the resulting detection frequency raster, with gray pixels indicating lower detection frequency than black pixels.}}{17}{figure.caption.17}%
\contentsline {figure}{\numberline {3.6}{\ignorespaces Examples of the four classification outcomes: variable vs. non-variable patches (rows), further split by tributary attribution (columns).}}{18}{figure.caption.18}%
\contentsline {figure}{\numberline {3.7}{\ignorespaces Visual overview of the steps involved in computing Morris sensitivity indices with respect to CWP area. The selected and classified CWP flow into the process at step 4.}}{19}{figure.caption.19}%
\contentsline {figure}{\numberline {3.8}{\ignorespaces Visual depiction of the second Morris sampling grid, spanning step length, reference strip width and the temperature delta threshold. The red arrow indicates the jump distance chosen.}}{20}{figure.caption.20}%
\contentsline {figure}{\numberline {3.9}{\ignorespaces Visual representation of the bounding box computation. One of the 24 selected CWPs is selected using the corresponding bounding box, then aggregation is performed. The resulting statistics can be captured in a table based format together with aggregation results from other selected CWP.}}{21}{figure.caption.21}%
\contentsline {figure}{\numberline {3.10}{\ignorespaces Illustration of the inverse distance weighting scheme used in v3. $t_1$ and $t_2$ are two reference temperature points with differing temperatures. The influence they have on determining the temperature of the indicated cell is given by the inverse of their squared distance. The temperature of the indicated cell is closer to that of $t_1$ as this reference point is closer.}}{23}{figure.caption.22}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {4.1}{\ignorespaces Execution time of v1 and v2 as a function of step length. In red the original CWP detection algorithm (v1), in blue the speed-optimized algorithm (v2).}}{27}{figure.caption.25}%
\contentsline {figure}{\numberline {4.2}{\ignorespaces Comparison of CWP polygon outputs between v1 (blue) and v2 (red) across the three validation runs. Polygons are overlaid at 50\% transparency; areas of agreement appear as a blend of both colours, while areas covered by only one algorithm appear in that algorithm's colour alone.}}{28}{figure.caption.26}%
\contentsline {figure}{\numberline {4.3}{\ignorespaces Morris sensitivity indices ($\mu ^*$ and $\sigma $) for step length with respect to cold water patch area, stratified by patch class.}}{29}{figure.caption.27}%
\contentsline {figure}{\numberline {4.4}{\ignorespaces $\mu ^*$ and $\sigma $ sensitivity indices for reference strip width, step length, and temperature delta across all classified cold water patches ($N = 24$ locations, $r = 64$ trajectories).}}{30}{figure.caption.28}%
\contentsline {figure}{\numberline {4.5}{\ignorespaces $\mu ^*$ (step length) versus mean CWP area for each of the 24 annotated locations. Color indicates the mean temperature delta to the surrounding river. The shape indicates CWP class (circle: non-tributary-caused; triangle: tributary-caused).}}{31}{figure.caption.29}%
\contentsline {figure}{\numberline {4.6}{\ignorespaces Qualitative comparison of CWP detections between v1 (blue) and v3 (green) at three example locations. v1 polygons and v3 polygons are overlaid at 50\% transparency; areas covered by both algorithms appear as a blend of the two colours, while areas covered by only one algorithm appear in that algorithm's colour alone.}}{32}{figure.caption.31}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {5.1}{\ignorespaces Annotated locations of cold water patches (CWP) in the Emme River. Each marker indicates the geographic position of a classified CWP. Background Image: Swissimage © Swisstopo}}{45}{figure.caption.37}%
\contentsline {figure}{\numberline {5.2}{\ignorespaces Catalogue of non-tributary-caused cold-water patches ($N = 14$). Each patch is shown as a detection frequency raster excerpt.}}{46}{figure.caption.38}%
\contentsline {figure}{\numberline {5.3}{\ignorespaces Catalogue of tributary-caused cold-water patches ($N = 10$). Each patch is shown as a detection frequency raster excerpt.}}{47}{figure.caption.39}%
