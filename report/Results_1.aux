\@writefile{toc}{\contentsline {section}{\numberline {5.1}Speed comparison in execution}{31}{section.5.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1-1}{\ignorespaces Execution time of the original (v1) and optimized (v2) implementations of \texttt  {detect\_cwp\_single} as a function of segment length. The optimized implementation shows execution times that are both shorter and largely constant across segment lengths, whereas the original implementation scales disproportionately with decreasing segment length (i.e., increasing number of segments).}}{31}{figure.caption.34}\protected@file@percent }
\newlabel{fig:speed_comparison}{{1-1}{31}{Execution time of the original (v1) and optimized (v2) implementations of \texttt {detect\_cwp\_single} as a function of segment length. The optimized implementation shows execution times that are both shorter and largely constant across segment lengths, whereas the original implementation scales disproportionately with decreasing segment length (i.e., increasing number of segments)}{figure.caption.34}{}}
