\@writefile{lof}{\contentsline {figure}{\numberline {2-2}{\ignorespaces Comparison of CWP polygon outputs between v1 (blue) and v2 (red) across the three validation runs. Polygons are overlaid at 50\% transparency; areas of agreement appear as a blend of both colours, while areas covered by only one algorithm appear in that algorithm's colour alone.}}{32}{figure.caption.35}\protected@file@percent }
\newlabel{fig:v1v2_comparison}{{2-2}{32}{Comparison of CWP polygon outputs between v1 (blue) and v2 (red) across the three validation runs. Polygons are overlaid at 50\% transparency; areas of agreement appear as a blend of both colours, while areas covered by only one algorithm appear in that algorithm's colour alone}{figure.caption.35}{}}
