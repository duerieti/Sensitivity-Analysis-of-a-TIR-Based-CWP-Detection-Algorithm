\newlabel{fig:v1v2_general}{{2-2a}{32}{General agreement, trial run 3 ($J = 0.976$). Discrepancies are confined to patch boundaries}{figure.caption.35}{}}
\newlabel{sub@fig:v1v2_general}{{a}{32}{General agreement, trial run 3 ($J = 0.976$). Discrepancies are confined to patch boundaries}{figure.caption.35}{}}
\newlabel{fig:v1v2_disagreement}{{2-2b}{32}{More pronounced disagreement, trial run 1 ($J = 0.936$). Boundary mismatches between v1 and v2 are more evident}{figure.caption.35}{}}
