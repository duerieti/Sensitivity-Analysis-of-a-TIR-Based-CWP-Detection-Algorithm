\@writefile{toc}{\contentsline {section}{\numberline {3.2}Speed comparison in execution}{17}{section.3.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2-1}{\ignorespaces Execution time of the original (v1) and optimized (v2) implementations of \texttt  {detect\_cwp\_single} as a function of segment length. The optimized implementation shows execution times that are both shorter and largely constant across segment lengths, whereas the original implementation scales disproportionately with decreasing segment length (i.e., increasing number of segments).}}{17}{figure.caption.20}\protected@file@percent }
\newlabel{fig:speed_comparison}{{2-1}{17}{Execution time of the original (v1) and optimized (v2) implementations of \texttt {detect\_cwp\_single} as a function of segment length. The optimized implementation shows execution times that are both shorter and largely constant across segment lengths, whereas the original implementation scales disproportionately with decreasing segment length (i.e., increasing number of segments)}{figure.caption.20}{}}
\@writefile{toc}{\contentsline {section}{\numberline {3.3}Sensitiviy scores for step length parameter}{17}{section.3.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3-2}{\ignorespaces Morris sensitivity indices ($\mu ^*$ and $\sigma $) for the \texttt  {step\_length} parameter with respect to cold water patch area, stratified by patch class (red: tributary-caused; blue: non-tributary-caused). Boxplots show the distribution across bounding boxes, with sample sizes ($n$) given below each box.}}{18}{figure.caption.21}\protected@file@percent }
\newlabel{fig:step_length_sensitivity}{{3-2}{18}{Morris sensitivity indices ($\mu ^*$ and $\sigma $) for the \texttt {step\_length} parameter with respect to cold water patch area, stratified by patch class (red: tributary-caused; blue: non-tributary-caused). Boxplots show the distribution across bounding boxes, with sample sizes ($n$) given below each box}{figure.caption.21}{}}
