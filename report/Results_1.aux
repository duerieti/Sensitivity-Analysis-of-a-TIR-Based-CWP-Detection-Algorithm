\@writefile{toc}{\contentsline {subsection}{\numberline {5.3.1}Output Comparison of v3 against v1}{39}{subsection.5.3.1}\protected@file@percent }
\newlabel{fig:v3_truncation}{{3-6a}{40}{Slab-boundary truncation eliminated. The v1 polygon ends abruptly at the slab boundary; the v3 polygon extends naturally beyond it}{figure.caption.43}{}}
\newlabel{sub@fig:v3_truncation}{{a}{40}{Slab-boundary truncation eliminated. The v1 polygon ends abruptly at the slab boundary; the v3 polygon extends naturally beyond it}{figure.caption.43}{}}
\newlabel{fig:v3_merger}{{3-6b}{40}{Merger of previously severed fragments. Two separate v1 polygons are detected as a single contiguous patch in v3}{figure.caption.43}{}}
\newlabel{sub@fig:v3_merger}{{b}{40}{Merger of previously severed fragments. Two separate v1 polygons are detected as a single contiguous patch in v3}{figure.caption.43}{}}
\newlabel{fig:v3_new}{{3-6c}{40}{New detection in v3. A CWP absent in v1 is detected by v3, consistent with the hypothesis that it was split into sub-threshold fragments by a slab boundary in v1}{figure.caption.43}{}}
\newlabel{sub@fig:v3_new}{{c}{40}{New detection in v3. A CWP absent in v1 is detected by v3, consistent with the hypothesis that it was split into sub-threshold fragments by a slab boundary in v1}{figure.caption.43}{}}
