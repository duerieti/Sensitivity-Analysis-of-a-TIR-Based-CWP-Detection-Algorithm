\@writefile{toc}{\contentsline {subsection}{\numberline {5.5.1}Output comparison}{35}{subsection.5.5.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5-1}{\ignorespaces Elimination of an artificial slab-boundary truncation. Left: v1 output, showing the CWP extent truncated abruptly at a slab boundary due to the discontinuous piecewise-constant reference temperature field. Right: v3 output, showing the patch extending naturally beyond the former boundary location, with the detected extent tapering gradually in accordance with the underlying temperature gradient.}}{36}{figure.caption.39}\protected@file@percent }
\newlabel{fig:idw_cutoff_eliminated}{{5-1}{36}{Elimination of an artificial slab-boundary truncation. Left: v1 output, showing the CWP extent truncated abruptly at a slab boundary due to the discontinuous piecewise-constant reference temperature field. Right: v3 output, showing the patch extending naturally beyond the former boundary location, with the detected extent tapering gradually in accordance with the underlying temperature gradient}{figure.caption.39}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.5.2}Runtime}{36}{subsection.5.5.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5-2}{\ignorespaces Merger of previously severed CWP fragments. Left: v1 output, showing two separate CWP polygons on either side of a slab boundary. Right: v3 output, showing the same thermal anomaly detected as a single contiguous patch.}}{37}{figure.caption.40}\protected@file@percent }
\newlabel{fig:idw_merged_cwp}{{5-2}{37}{Merger of previously severed CWP fragments. Left: v1 output, showing two separate CWP polygons on either side of a slab boundary. Right: v3 output, showing the same thermal anomaly detected as a single contiguous patch}{figure.caption.40}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5-3}{\ignorespaces Example of a CWP detected by v3 but absent in v1 and v2. The detection is consistent with the hypothesis that the corresponding thermal anomaly was split into sub-threshold fragments by a slab boundary in v1 and v2, and subsequently removed by the minimum area filter.}}{37}{figure.caption.41}\protected@file@percent }
\newlabel{fig:idw_new_cwp}{{5-3}{37}{Example of a CWP detected by v3 but absent in v1 and v2. The detection is consistent with the hypothesis that the corresponding thermal anomaly was split into sub-threshold fragments by a slab boundary in v1 and v2, and subsequently removed by the minimum area filter}{figure.caption.41}{}}
