\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:morris_grid}{{1-1}{2}{An example grid $\Omega $. The grid features two parameters $X_1$, $X_2$, meaning that it is a two-dimensional grid. Further, it features four levels ($p = 4$). The step length $\Delta $ chosen here is $\frac {2}{3}$, which corresponds to an element of the set of viable values for $\Delta $: $1 - \frac {1}{4-1} = 1 - \frac {1}{3} = \frac {2}{3}$}{figure.caption.1}{}}
